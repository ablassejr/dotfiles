{
  "schema_version": 1,
  "skill": "archify",
  "tools": [
    {
      "id": "node",
      "command": "node",
      "kind": "brew",
      "package": "node",
      "purpose": "Run Node utilities and npm packages",
      "documentation": "https://formulae.brew.sh/formula/node",
      "min_version": "18.0.0",
      "required": true
    },
    {
      "id": "archify-development",
      "kind": "bundled-npm",
      "path": ".",
      "depends": [
        "node"
      ],
      "purpose": "Install packaged Archify development dependencies when development tooling requires them",
      "documentation": "https://docs.npmjs.com/cli/v11/commands/npm-install",
      "required": false
    },
    {
      "id": "playwright",
      "kind": "npm",
      "package": "playwright",
      "command": "playwright",
      "purpose": "Browser rendering when a native viewer is unavailable",
      "depends": [
        "node"
      ],
      "documentation": "https://www.npmjs.com/package/playwright",
      "required": false
    },
    {
      "id": "browser-chromium",
      "kind": "browser",
      "browser": "chromium",
      "depends": [
        "playwright"
      ],
      "purpose": "Install Chromium for the isolated Playwright fallback",
      "documentation": "https://playwright.dev/docs/browsers",
      "required": false
    }
  ],
  "external_requirements": []
}
