# Keep non-login zsh shells aligned with the login-shell environment.
if [[ ! -o login && -r "$HOME/.zprofile" ]]; then
  source "$HOME/.zprofile"
fi

path() {
  realpath "$1" | pbcopy
}

if [[ -o interactive ]] && command -v ccswitch >/dev/null 2>&1; then
  eval "$(ccswitch shell-init)"
fi

# Pants shell completion is expensive (boots the Pants daemon). Run on demand
# from inside a Pants repo: `pants-init`.
pants-init() {
  emulate -L zsh
  if ! command -v pants >/dev/null 2>&1; then
    print -u2 "pants-init: pants not in PATH"
    return 1
  fi
  local dir="$PWD"
  while [[ "$dir" != "/" && ! -f "$dir/pants.toml" ]]; do
    dir="${dir:h}"
  done
  if [[ ! -f "$dir/pants.toml" ]]; then
    print -u2 "pants-init: no pants.toml above $PWD"
    return 1
  fi
  local completion
  completion="$(pants complete zsh </dev/null 2>/dev/null)" || {
    print -u2 "pants-init: 'pants complete zsh' failed"
    return 1
  }
  [[ -z "$completion" ]] && { print -u2 "pants-init: empty completion output"; return 1; }
  autoload -Uz +X bashcompinit && bashcompinit
  eval "$completion"
}

