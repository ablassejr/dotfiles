# Sync a machine:   brew bundle --file=Brewfile
# Check for drift:  brew bundle check --file=Brewfile
# Refresh from this machine: brew bundle dump --file=Brewfile --force
#
# chezmoi ignores this file; it is repository tooling, not a dotfile.

