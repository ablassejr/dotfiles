<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_multimodal-research-workflow" targetNamespace="https://specflow.local/workflows">
  <bpmn:process id="multimodal-research-workflow" name="Evidence research gate" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="v1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="gather_research" name="Gather Research">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="specflow.gather-research" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="skill" value="specification-research-loop" />
          <zeebe:header key="phase" value="gather_research" />
          <zeebe:header key="visualPolicy" value="graph-renderers-v1" />
          <zeebe:header key="visualInventory" value="required" />
          <zeebe:header key="approvalPolicy" value="approval-economy-v1" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="evaluate_research" name="Evaluate Research">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="specflow.evaluate-research" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="skill" value="speckit-autonomous-research-gate" />
          <zeebe:header key="phase" value="evaluate_research" />
          <zeebe:header key="visualPolicy" value="graph-renderers-v1" />
          <zeebe:header key="approvalPolicy" value="approval-economy-v1" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="research_gate" name="Research Gate">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="research_complete" name="Research Complete">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="gather_research" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="gather_research" targetRef="evaluate_research" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="evaluate_research" targetRef="research_gate" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="research_gate" targetRef="gather_research">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= researchOutcome = "CONTINUE_RESEARCH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" sourceRef="research_gate" targetRef="research_complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= researchOutcome = "PROCEED" or researchOutcome = "REQUEST_HITL" or researchOutcome = "REVISE_FIRST_PRINCIPLES"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_multimodal-research-workflow">
    <bpmndi:BPMNPlane id="BPMNPlane_multimodal-research-workflow" bpmnElement="multimodal-research-workflow">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gather_research_di" bpmnElement="gather_research">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evaluate_research_di" bpmnElement="evaluate_research">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="research_gate_di" bpmnElement="research_gate" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="research_complete_di" bpmnElement="research_complete">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="75.0" y="70.0" />
        <di:waypoint x="225.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="225.0" y="70.0" />
        <di:waypoint x="375.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="375.0" y="70.0" />
        <di:waypoint x="525.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="525.0" y="70.0" />
        <di:waypoint x="225.0" y="70.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="525.0" y="70.0" />
        <di:waypoint x="675.0" y="70.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>