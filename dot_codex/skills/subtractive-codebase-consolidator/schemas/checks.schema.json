{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "e2e",
            "integration",
            "behavior",
            "analyzer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "argv": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "version_argv": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Version Argv",
          "type": "array"
        },
        "obligations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "seams": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Seams",
          "type": "array"
        },
        "exercised_scope": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Exercised Scope",
          "type": "array"
        },
        "skipped_scope": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Skipped Scope",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "argv",
        "version_argv",
        "obligations",
        "seams",
        "exercised_scope",
        "skipped_scope"
      ],
      "title": "Check",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "checks"
  ],
  "title": "Checks",
  "type": "object"
}
