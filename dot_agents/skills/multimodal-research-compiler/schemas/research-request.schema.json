{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/multimodal-research-compiler/research-request.schema.json",
  "title": "Research Request",
  "type": "object",
  "required": ["research_request"],
  "properties": {
    "research_request": {
      "type": "object",
      "required": ["request_id", "mode", "question"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "mode": {
          "enum": ["DISCOVERY", "GROUNDING", "DECISION_SUPPORT", "IMPLEMENTATION", "VERIFICATION", "IMPACT_ANALYSIS"]
        },
        "question": {
          "type": "object",
          "required": ["statement"],
          "properties": {
            "id": {"type": "string"},
            "statement": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "purpose": {
          "type": "object",
          "properties": {
            "decision_ref": {"type": "string"},
            "expected_use": {"type": "string"},
            "audience": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": true
        },
        "first_principles_basis": {"type": "object"},
        "semantic_authority": {"type": "object"},
        "implementation_context": {"type": "object"},
        "boundaries": {
          "type": "object",
          "properties": {
            "allowed_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "time_scope": {"type": "string"},
            "dependency_versions": {"type": "string"}
          },
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "properties": {
            "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": true
        },
        "confidence_requirement": {"enum": ["low", "medium", "high"]},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
