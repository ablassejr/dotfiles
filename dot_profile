# Shared POSIX-ish environment for shells that read ~/.profile.

path_prepend() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
  *":$1:"*) ;;
  *) PATH="$1:$PATH" ;;
  esac
}

path_append() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
  *":$1:"*) ;;
  *) PATH="$PATH:$1" ;;
  esac
}

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.bun/bin"
path_prepend "$HOME/.opencode/bin"
path_prepend "$HOME/.local/share/mise/shims"
path_prepend "/opt/homebrew/bin"
path_prepend "/opt/homebrew/sbin"
path_prepend "/opt/local/bin"
path_prepend "/opt/local/sbin"
path_prepend "/opt/homebrew/opt/postgresql@15/bin"
path_append "/Library/TeX/texbin"
path_append "$HOME/.lmstudio/bin"
path_append "$HOME/.maestro/bin"
path_append "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
path_append "$HOME/Library/Application Support/Coursier/bin"
path_append "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
path_append "/Applications/Obsidian.app/Contents/MacOS"

export PATH
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"

unset -f path_prepend path_append

