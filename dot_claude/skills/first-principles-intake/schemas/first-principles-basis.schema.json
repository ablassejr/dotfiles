{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/schemas/first-principles-basis.schema.json",
  "title": "First-Principles Basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "basis_id",
    "task_ref",
    "version",
    "supersedes_basis_id",
    "intake_provenance",
    "desired_state",
    "underlying_problem",
    "irreducible_new_behavior",
    "expected_simplification",
    "minimum_sufficient_change",
    "invariants",
    "hard_constraints",
    "non_goals",
    "forbidden_tradeoffs",
    "success_evidence",
    "assumptions",
    "unresolved",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "epic-spec.first-principles-basis"},
    "basis_id": {"type": "string", "pattern": "^FPB-.+-[0-9]{3}$"},
    "task_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "version": {"type": "integer", "minimum": 1},
    "supersedes_basis_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "intake_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_isolation",
        "implementation_context_exposed",
        "sources",
        "question_resolution",
        "agent_solution_proposals",
        "agent_introduced_implementation_terms"
      ],
      "properties": {
        "context_isolation": {"enum": ["fresh", "restricted"]},
        "implementation_context_exposed": {"const": false},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "ref"],
            "properties": {
              "type": {
                "enum": [
                  "user_request",
                  "task_or_ticket_statement",
                  "approved_product_goal",
                  "explicit_constraint"
                ]
              },
              "ref": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        },
        "question_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desired_state",
            "underlying_problem",
            "irreducible_new_behavior",
            "expected_simplification",
            "invariants",
            "minimum_sufficient_change",
            "success_evidence"
          ],
          "properties": {
            "desired_state": {"enum": ["inferred_from_allowed_input", "asked_and_answered"]},
            "underlying_problem": {"enum": ["inferred_from_allowed_input", "asked_and_answered"]},
            "irreducible_new_behavior": {"enum": ["inferred_from_allowed_input", "asked_and_answered"]},
            "expected_simplification": {"enum": ["inferred_from_allowed_input", "asked_and_answered"]},
            "invariants": {"enum": ["inferred_from_allowed_input", "asked_and_answered"]},
            "minimum_sufficient_change": {"enum": ["inferred_from_allowed_input", "asked_and_answered", "not_needed"]},
            "success_evidence": {"enum": ["inferred_from_allowed_input", "asked_and_answered", "not_needed"]}
          }
        },
        "agent_solution_proposals": {"type": "array", "maxItems": 0},
        "agent_introduced_implementation_terms": {"type": "array", "maxItems": 0}
      }
    },
    "desired_state": {"$ref": "#/$defs/statementWithObservableEffects"},
    "underlying_problem": {"$ref": "#/$defs/statementWithConsequences"},
    "irreducible_new_behavior": {
      "allOf": [{"$ref": "#/$defs/stringList"}, {"minItems": 1}]
    },
    "expected_simplification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responsibility", "expected_to_disappear"],
        "properties": {
          "responsibility": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "expected_to_disappear": {"type": "boolean"}
        }
      }
    },
    "minimum_sufficient_change": {"$ref": "#/$defs/statement"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identifiedStatement"}
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/identifiedStatement"},
          {
            "type": "object",
            "required": ["source"],
            "properties": {"source": {"type": "string", "minLength": 1, "pattern": "\\S"}}
          }
        ]
      }
    },
    "non_goals": {"$ref": "#/$defs/stringList"},
    "forbidden_tradeoffs": {"$ref": "#/$defs/stringList"},
    "success_evidence": {
      "allOf": [{"$ref": "#/$defs/stringList"}, {"minItems": 1}]
    },
    "assumptions": {"$ref": "#/$defs/stringList"},
    "unresolved": {"$ref": "#/$defs/stringList"},
    "approved_by": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
    "approved_at": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {"statement": {"type": "string", "minLength": 1, "pattern": "\\S"}}
    },
    "statementWithObservableEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "observable_effects"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observable_effects": {"$ref": "#/$defs/stringList"}
      }
    },
    "statementWithConsequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "consequences"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "consequences": {"$ref": "#/$defs/stringList"}
      }
    },
    "identifiedStatement": {
      "type": "object",
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "statement": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}
