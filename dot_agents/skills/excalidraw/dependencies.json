      "depends": [
        "node"
      ],
      "documentation": "https://www.npmjs.com/package/excalidraw-brute-export-cli",
      "required": false
    },
    {
      "id": "browser-firefox",
      "kind": "browser",
      "browser": "firefox",
      "depends": [
        "playwright"
      ],
      "purpose": "Install Firefox for selected Excalidraw browser export",
      "documentation": "https://playwright.dev/docs/browsers",
      "required": false
    },
    {
      "id": "curl",
      "command": "curl",
      "kind": "brew",
      "package": "curl",
      "purpose": "Retrieve documented HTTP resources",
      "documentation": "https://formulae.brew.sh/formula/curl",
      "required": false
    },
    {
      "id": "node",
      "command": "node",
      "kind": "brew",
      "package": "node",
      "purpose": "Run Node utilities and npm packages",
      "documentation": "https://formulae.brew.sh/formula/node",
      "min_version": "18.0.0",
      "required": false
    }
