{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/issue-review.schema.json",
  "title": "Individual issue review and team assignment",
  "oneOf": [
    {
      "$ref": "#/$defs/createdIssues"
    },
    {
      "$ref": "#/$defs/reviewReceipt"
    },
    {
      "$ref": "#/$defs/standaloneReviewReceipt"
    },
    {
      "$ref": "#/$defs/teamAssignmentBinding"
    }
  ],
  "$defs": {
    "createdIssue": {
      "type": "object",
      "required": [
        "plan_key",
        "id",
        "identifier",
        "project_id",
        "assignee_id",
        "verified_at",
        "evidence",
        "content"
      ],
      "properties": {
        "plan_key": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "assignee_id": {
          "type": "null"
        },
        "content": {
          "$ref": "#/$defs/issueContent"
        }
      }
    },
    "createdIssues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/createdIssue"
      }
    },
    "reviewReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "issue",
        "program_process_instance_key",
        "review_process_instance_key",
        "approval_task_key",
        "design",
        "proposal"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "type": "object",
          "required": [
            "ref",
            "hash"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "issue": {
          "$ref": "#/$defs/createdIssue"
        },
        "program_process_instance_key": {
          "type": "string",
          "minLength": 1
        },
        "review_process_instance_key": {
          "type": "string",
          "minLength": 1
        },
        "approval_task_key": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "object",
          "required": [
            "ref",
            "hash"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "proposal": {
          "type": "object",
          "required": [
            "id",
            "url",
            "revision",
            "hash"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scope": {
          "const": "program"
        }
      }
    },
    "teamAssignmentBinding": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "review_set_hash",
        "assignments",
        "verified_at",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "type": "object",
          "required": [
            "ref",
            "hash"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "review_set_hash": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "issue_id",
              "owner",
              "assignee_id",
              "readback_assignee_id"
            ],
            "properties": {
              "issue_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "assignee_id": {
                "type": "string",
                "minLength": 1
              },
              "readback_assignee_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "issueContent": {
      "type": "object",
      "required": [
        "title",
        "body",
        "comments",
        "document_attachments"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "design_proposal_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "document_attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "standaloneReviewReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "review_process_instance_key",
        "approval_task_key",
        "design",
        "proposal",
        "scope",
        "issue",
        "basis"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/reviewReceipt/properties/schema_version"
        },
        "review_process_instance_key": {
          "$ref": "#/$defs/reviewReceipt/properties/review_process_instance_key"
        },
        "approval_task_key": {
          "$ref": "#/$defs/reviewReceipt/properties/approval_task_key"
        },
        "design": {
          "$ref": "#/$defs/reviewReceipt/properties/design"
        },
        "proposal": {
          "$ref": "#/$defs/reviewReceipt/properties/proposal"
        },
        "scope": {
          "const": "standalone"
        },
        "issue": {
          "type": "object",
          "required": [
            "identifier"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "basis": {
          "$ref": "#/$defs/reviewReceipt/properties/source"
        }
      },
      "additionalProperties": false
    }
  }
}
