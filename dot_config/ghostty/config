# Font
font-family = "AdwaitaMono Nerd Font"
font-size = 14
font-thicken = false

# Window
window-theme = auto
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# Cursor styling
cursor-style = "block"
cursor-style-blink = true

# Ghostty overrides this key rather than merging, so every feature belongs on
# one line: no-cursor keeps the block cursor at the prompt, ssh-env forwards
# TERM/COLORTERM so remote hosts render correctly.
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = global:super+shift+enter=toggle_quick_terminal
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Window navigation (Vim-style)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
