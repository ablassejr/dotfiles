{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/schemas/project-resources.schema.json",
  "title": "Linear project artifact inventory or resource binding",
  "oneOf": [
    {
      "$ref": "#/$defs/inventory"
    },
    {
      "$ref": "#/$defs/binding"
    }
  ],
  "$defs": {
    "inventory": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "root",
        "artifacts",
        "inventory_hash"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "source": {
          "type": "object",
          "required": [
            "ref",
            "hash"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "sha256",
              "size",
              "content_type"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inventory_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "inventory_hash",
        "carrier",
        "project_id",
        "resources",
        "readback"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "source": {
          "type": "object",
          "required": [
            "ref",
            "hash"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inventory_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "carrier": {
          "type": "object"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "artifact_key",
              "resource_id",
              "project_id",
              "sha256",
              "readback_sha256",
              "asset_url"
            ],
            "properties": {
              "artifact_key": {
                "type": "string",
                "minLength": 1
              },
              "resource_id": {
                "type": "string",
                "minLength": 1
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "readback_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "asset_url": {
                "type": "string",
                "pattern": "^https://uploads\\.linear\\.app/[^?#]+$"
              }
            }
          }
        },
        "readback": {
          "type": "object",
          "required": [
            "project_id",
            "resource_ids",
            "verified_at",
            "access"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "resource_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verified_at": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "object",
              "required": [
                "scope",
                "verified",
                "evidence"
              ],
              "properties": {
                "scope": {
                  "const": "project_members"
                },
                "verified": {
                  "const": true
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
