[[ -r "$HOME/.profile" ]] && source "$HOME/.profile"

if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if [[ -d /opt/homebrew/opt/postgresql@15 ]]; then
  export LDFLAGS="-L/opt/homebrew/opt/postgresql@15/lib ${LDFLAGS:-}"
  export CPPFLAGS="-I/opt/homebrew/opt/postgresql@15/include ${CPPFLAGS:-}"
fi

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
[[ -d "$BUN_INSTALL/bin" && ":$PATH:" != *":$BUN_INSTALL/bin:"* ]] && export PATH="$BUN_INSTALL/bin:$PATH"

[[ -d "$HOME/.opencode/bin" && ":$PATH:" != *":$HOME/.opencode/bin:"* ]] && export PATH="$HOME/.opencode/bin:$PATH"

alias ll="ls -lh"
alias la="eza --long --tree --level 3"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias ce="chezmoi edit"
alias ca="chezmoi apply"
alias clr="clear"
alias ghosttyconfig="$HOME/.config/ghostty/config"
alias nvimp="NVIM_APPNAME=nvim-personal nvim"
alias nvidep="NVIM_APPNAME=nvim-personal neovide"
alias nvide="neovide"
alias nvimdir='nvim "$(find . -type d | fzf)"'
alias nvimfile='nvim "$(fzf)"'
alias nvidedir='neovide "$(find . -type d | fzf)"'
alias nvidefile='neovide "$(fzf)"'
alias codexfull="codex --search --sandbox danger-full-access --dangerously-bypass-approvals-and-sandbox"
alias YOLO="claude --permission-mode=bypassPermissions --"
alias utar="tar -xf"
alias tm="task-master"
alias taskmaster="task-master"
alias oc="opencode"
alias claude-mem='bun "$HOME/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-service.cjs"'
alias docs-mcp-server="npx @arabold/docs-mcp-server@latest --resume"
alias flink-connect:prod="ssh root@137.184.209.231"
alias flink-connect:prod:ui="ssh -L 8081:127.0.0.1:8081 root@137.184.209.231"
alias github-runner-1="ssh runner@161.35.126.21"
alias matlab="/Applications/MATLAB_R2025b.app/bin/matlab"

[[ -o interactive ]] || return

setopt autocd
setopt correct
setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE="${HISTSIZE:-50000}"
SAVEHIST="${SAVEHIST:-50000}"

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh | sed 's/\[\[ -o zle \]\]/[[ -n ${ZLE_VERSION:-} ]]/')"
fi

autoload -Uz compinit
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump-${ZSH_VERSION}"

[[ -r /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh 2>/dev/null
[[ -r /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh 2>/dev/null
[[ -r /usr/local/opt/fzf/shell/key-bindings.zsh ]] && source /usr/local/opt/fzf/shell/key-bindings.zsh 2>/dev/null
[[ -r /usr/local/opt/fzf/shell/completion.zsh ]] && source /usr/local/opt/fzf/shell/completion.zsh 2>/dev/null

source_first_readable() {
  local file
  for file in "$@"; do
    [[ -r "$file" ]] || continue
    source "$file"
    return 0
  done
  return 1
}

source_first_readable \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /opt/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh

source_first_readable \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /opt/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

unset -f source_first_readable

[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
