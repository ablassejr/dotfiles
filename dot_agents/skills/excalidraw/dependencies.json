      "documentation": "https://formulae.brew.sh/formula/python",
      "min_version": "3.9.0",
      "required": true
    },
    {
      "id": "playwright",
      "kind": "npm",
      "package": "playwright",
      "command": "playwright",
      "purpose": "Browser rendering when a native viewer is unavailable",
      "depends": [
        "node"
      ],
      "documentation": "https://www.npmjs.com/package/playwright",
      "required": false
    },
    {
      "id": "browser-chromium",
      "kind": "browser",
      "browser": "chromium",
      "depends": [
        "playwright"
      ],
      "purpose": "Install Chromium for the isolated Playwright fallback",
      "documentation": "https://playwright.dev/docs/browsers",
      "required": false
    },
    {
      "id": "excalidraw-export",
      "kind": "npm",
      "package": "excalidraw-brute-export-cli",
