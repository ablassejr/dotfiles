{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/schemas/decision-question.schema.json",
  "title": "Selected Decision Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "frontier_revision",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "kind": {
      "const": "epic-spec.decision-question"
    },
    "frontier_revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "status",
        "question",
        "why_this_is_needed",
        "first_principles_links",
        "current_state",
        "prerequisites",
        "grounding_status",
        "actions"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "unresolved"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "why_this_is_needed": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "first_principles_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "current_state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "status"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "const": "resolved"
              }
            }
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "code_mass_effect",
              "consequences"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "code_mass_effect": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "added",
                      "removed",
                      "expected_ratio",
                      "expected_net"
                    ],
                    "properties": {
                      "added": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "removed": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "expected_ratio": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "expected_net": {
                        "type": "integer"
                      }
                    }
                  },
                  {
                    "const": "UNKNOWN"
                  }
                ]
              },
              "consequences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "option",
            "confidence",
            "criteria"
          ],
          "properties": {
            "option": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "confidence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_principles_alignment",
                "behavioral_correctness",
                "code_mass_effect",
                "conceptual_complexity",
                "reversibility",
                "operational_risk",
                "migration_cost"
              ],
              "properties": {
                "first_principles_alignment": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "behavioral_correctness": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "code_mass_effect": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "conceptual_complexity": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "reversibility": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "operational_risk": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "migration_cost": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "grounding_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit_rationale_found",
            "grounding_recommended",
            "target"
          ],
          "properties": {
            "explicit_rationale_found": {
              "type": "boolean"
            },
            "grounding_recommended": {
              "type": "boolean"
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "required": [
              "options",
              "recommendation"
            ],
            "properties": {
              "options": {
                "minItems": 2
              },
              "actions": {
                "minItems": 4
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "properties": {
              "actions": {
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "answer",
                    "ground_me"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
