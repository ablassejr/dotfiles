{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_digest": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "source_sha256",
          "start",
          "end",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "REFERENCES",
              "IMPLEMENTS",
              "CALLS",
              "READS_STATE",
              "WRITES_STATE",
              "IMPORTS"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "provider_claimed_precise",
              "structural",
              "unknown"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "confidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "provider",
    "provider_version",
    "snapshot_digest",
    "coverage",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
