{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/multimodal-research-compiler/source.schema.json",
  "title": "Research Source",
  "type": "object",
  "required": ["source_id", "source_type", "title", "locator"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "source_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "revision": {"type": "string"},
    "published_at": {"type": "string"},
    "retrieved_at": {"type": "string"},
    "authority_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scope": {"type": "object"},
    "excerpts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["excerpt_id", "locator"],
        "properties": {
          "excerpt_id": {"type": "string"},
          "locator": {"type": "string"},
          "text": {"type": "string"},
          "digest": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
