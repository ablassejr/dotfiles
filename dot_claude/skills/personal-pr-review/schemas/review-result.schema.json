{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local review status and final result",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "complete"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "analysis_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "PASS_WITH_DEBT",
        "HOLD",
        "INCOMPLETE",
        "STALE"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "integrity": {
      "enum": [
        "UNCHANGED",
        "CHANGED",
        "UNVERIFIED"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_origin": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
