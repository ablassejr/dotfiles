{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized local review request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "range",
        "commit",
        "staged",
        "working-tree"
      ]
    },
    "base_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison": {
      "type": "string",
      "enum": [
        "merge-base",
        "direct",
        "snapshot"
      ]
    },
    "parent": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    }
  },
  "required": [
    "schema_version",
    "repository",
    "mode",
    "base_ref",
    "head_ref",
    "comparison",
    "parent",
    "output",
    "depth"
  ],
  "additionalProperties": false
}
