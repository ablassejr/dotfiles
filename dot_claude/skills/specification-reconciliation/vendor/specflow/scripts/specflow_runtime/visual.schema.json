{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual record with graph renderer evidence",
  "type": "object",
  "required": [
    "ref",
    "kind"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "graph",
        "screenshot",
        "photo",
        "video",
        "table",
        "code",
        "diff",
        "mockup"
      ]
    },
    "renderer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        }
      },
      "then": {
        "required": [
          "renderer",
          "artifact",
          "receipt"
        ],
        "properties": {
          "renderer": {
            "enum": [
              "figma",
              "likec4",
              "archify"
            ]
          }
        }
      }
    }
  ],
  "$id": "https://specflow.local/schemas/visual.schema.json"
}
